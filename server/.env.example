# Copy to .env and fill in. Values below match docker-compose.yml.
DATABASE_URL="postgresql://foodspots:foodspots@localhost:5432/foodspots?schema=public"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# Any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Google OAuth 2.0 — from console.cloud.google.com credentials (Web application client)
GOOGLE_CLIENT_ID=""

# Google Maps Platform server key. Needs Directions API enabled (used for food crawl routing).
GOOGLE_MAPS_SERVER_KEY=""

# Cloudinary — from cloudinary.com dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
