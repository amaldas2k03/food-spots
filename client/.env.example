# Copy to .env. Only VITE_-prefixed vars reach the browser.

# MapTiler Cloud API key — renders the basemap tiles, pins and heatmap.
# Get one at https://cloud.maptiler.com/account/keys/ and restrict it to
# http://localhost:5173. Without this, map pages show a configuration notice
# instead of a map.
VITE_MAPTILER_KEY=""

# Google OAuth 2.0 Web client ID — must match GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=""

# Leave unset in dev: Vite proxies /api to the server (see vite.config.js).
VITE_API_URL=""
