# Copy to .env. Only VITE_-prefixed vars reach the browser.

# Google Maps JavaScript API key (browser key).
# Enable: Maps JavaScript API, Places API. Restrict it to http://localhost:5173/*
# Without this, map pages show a configuration notice instead of a map.
VITE_GOOGLE_MAPS_API_KEY=""

# Google OAuth 2.0 Web client ID — must match GOOGLE_CLIENT_ID on the server.
VITE_GOOGLE_CLIENT_ID=""

# Leave unset in dev: Vite proxies /api to the server (see vite.config.js).
VITE_API_URL=""
